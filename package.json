{
  "name": "escape-sso",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./vercel": {
      "types": "./dist/adapters/vercel.d.ts",
      "default": "./dist/adapters/vercel.js"
    },
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./fetch": {
      "types": "./dist/adapters/fetch.d.ts",
      "default": "./dist/adapters/fetch.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "jose": "6.2.17",
    "oauth4webapi": "3.8.8"
  },
  "peerDependencies": {
    "@vercel/functions": "3.11.1"
  },
  "peerDependenciesMeta": {
    "@vercel/functions": {
      "optional": true
    }
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "26.6.6",
    "@vercel/functions": "3.11.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
